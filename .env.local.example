# Duplex frontend — environment template.
# Copy this file to .env.local and adjust if your broker runs somewhere other than the default.
#
#   cp .env.local.example .env.local
#
# NEXT_PUBLIC_ vars are inlined at BUILD time, not read at runtime. So when you deploy, this
# must be set for the build step, and a change needs a rebuild.

# Where the browser posts its WebRTC offer — the Duplex broker.
# Local default (matches the broker on port 8000):
NEXT_PUBLIC_BROKER_URL=http://localhost:8000
# Deployed (point this at the broker's own URL, e.g. on Render):
# NEXT_PUBLIC_BROKER_URL=https://duplex-broker.onrender.com
